{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["e2e/*.ts", "playwright.config.ts"]
}
